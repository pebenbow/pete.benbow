---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Glow from "../components/Glow.astro";
import CvOrgList from "../components/CvOrgList.astro";
import { socialLinks } from "../data/social";
import {
    education,
    appointments,
    priorExperience,
    teaching,
    software,
    conferences,
    service,
    honors,
} from "../data/cv";

const tocSections = [
    { id: "education", icon: "lucide:graduation-cap", title: "Education" },
    {
        id: "appointments",
        icon: "lucide:briefcase",
        title: "Academic Appointments",
    },
    { id: "teaching", icon: "lucide:book-open", title: "Teaching" },
    { id: "service", icon: "lucide:handshake", title: "Service" },
    {
        id: "scholarship",
        icon: "lucide:lightbulb",
        title: "Scholarship & Professional Activity",
    },
    {
        id: "prior-experience",
        icon: "lucide:building-2",
        title: "Prior Professional Experience",
    },
    { id: "honors", icon: "lucide:award", title: "Honors and Awards" },
];

const serviceGroups = [
    { title: "College Service", items: service.college },
    { title: "Professional Service", items: service.professional },
    { title: "Alumni Service", items: service.alumni },
];

const sectionHeadingClass = "flex items-center gap-2.5 print:gap-0";
const iconBadgeClass =
    "flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent-500/10 text-accent-400 print:hidden";
const headingTextClass =
    "font-display text-xl font-semibold text-ink-50 print:text-black";
const cardClass =
    "rounded-xl border border-ink-800 bg-ink-900 p-6 print:rounded-none print:border-0 print:bg-transparent print:p-0";
const bodyListClass =
    "text-base text-ink-400 print:text-sm print:text-neutral-700";
---

<BaseLayout
    title="Pete Benbow — Curriculum Vitae"
    description="Curriculum Vitae for Pete Benbow, Assistant Professor of the Practice in Data Science at Davidson College."
>
    <article
        id="cv"
        class="relative mx-auto max-w-3xl px-6 py-20 print:max-w-none print:px-0 print:py-0"
    >
        <Glow color="var(--color-accent-500)" class="-top-20 -right-32" />
        <Glow color="var(--color-violet-500)" class="top-[45%] -left-40" />
        <Glow color="var(--color-coral-500)" class="bottom-0 -right-32" />

        <div class="flex flex-wrap items-start justify-between gap-4 print:hidden">
            <div>
                <h1 class="font-display text-4xl font-bold text-ink-50">
                    Curriculum Vitae
                </h1>
                <p class="mt-1 text-ink-400">Pete Benbow</p>
                <div class="mt-3 flex items-center gap-4">
                    {socialLinks.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noreferrer"
                            aria-label={link.label}
                            class="text-ink-400 transition-colors hover:text-accent-400"
                        >
                            <Icon name={link.icon} class="h-5 w-5" />
                        </a>
                    ))}
                </div>
            </div>
            <a
                href="/pete-benbow-cv.pdf"
                class="flex items-center gap-2 rounded-full bg-accent-500 px-6 py-2.5 text-sm font-semibold text-ink-50 transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-600 hover:shadow-lg hover:shadow-accent-500/30"
                download
            >
                <Icon name="lucide:download" class="h-4 w-4" />
                Download PDF
            </a>
        </div>

        <h1 class="hidden font-display text-3xl font-bold text-black print:mb-1 print:block">
            Pete Benbow — Curriculum Vitae
        </h1>

        <nav
            class={`mt-8 print:hidden ${cardClass}`}
            aria-label="Table of contents"
        >
            <p class="font-display text-xs font-semibold uppercase tracking-wider text-ink-400">
                On this page
            </p>
            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                {tocSections.map((s) => (
                    <li>
                        <a
                            href={`#${s.id}`}
                            class="flex items-center gap-2 text-sm font-medium text-ink-200 transition-colors hover:text-accent-400"
                        >
                            <Icon
                                name={s.icon}
                                class="h-4 w-4 text-accent-400"
                            />
                            {s.title}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <section id="education" class="mt-8 print:mt-4">
            <div class={sectionHeadingClass}>
                <span class={iconBadgeClass}>
                    <Icon name="lucide:graduation-cap" class="h-4 w-4" />
                </span>
                <h2 class={headingTextClass}>Education</h2>
            </div>
            <div class={`mt-3 ${cardClass}`}>
                <ul class="space-y-1 text-ink-200 print:text-black">
                    {education.map((entry) => (
                        <li>
                            {entry.degree} ({entry.year}), {entry.institution}
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <section id="appointments" class="mt-8 print:mt-4">
            <div class={sectionHeadingClass}>
                <span class={iconBadgeClass}>
                    <Icon name="lucide:briefcase" class="h-4 w-4" />
                </span>
                <h2 class={headingTextClass}>Academic Appointments</h2>
            </div>
            <CvOrgList orgs={appointments} />
        </section>

        <section id="teaching" class="mt-8 print:mt-4">
            <div class={sectionHeadingClass}>
                <span class={iconBadgeClass}>
                    <Icon name="lucide:book-open" class="h-4 w-4" />
                </span>
                <h2 class={headingTextClass}>Teaching</h2>
            </div>
            <div class={`mt-3 ${cardClass}`}>
                <h3 class="font-display text-base font-semibold text-ink-100 print:text-black">
                    Classroom Instruction
                </h3>
                <ul class={`mt-1 list-disc space-y-1 pl-5 ${bodyListClass}`}>
                    {teaching.classroom.map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
                <h3 class="mt-4 font-display text-base font-semibold text-ink-100 print:text-black">
                    Independent Study
                </h3>
                <ul class={`mt-1 list-disc space-y-1 pl-5 ${bodyListClass}`}>
                    {teaching.independent.map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
                <h3 class="mt-4 font-display text-base font-semibold text-ink-100 print:text-black">
                    Advising &amp; Mentoring
                </h3>
                <ul class={`mt-1 list-disc space-y-1 pl-5 ${bodyListClass}`}>
                    {teaching.mentoring.map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
                <h3 class="mt-4 font-display text-base font-semibold text-ink-100 print:text-black">
                    Online Instruction (edX)
                </h3>
                <ul class={`mt-1 list-disc space-y-1 pl-5 ${bodyListClass}`}>
                    {teaching.online.map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
            </div>
        </section>

        <section id="service" class="mt-8 print:mt-4">
            <div class={sectionHeadingClass}>
                <span class={iconBadgeClass}>
                    <Icon name="lucide:handshake" class="h-4 w-4" />
                </span>
                <h2 class={headingTextClass}>Service</h2>
            </div>
            <div class={`mt-3 ${cardClass}`}>
                {serviceGroups.map((group, i) => (
                    <>
                        <h3
                            class={`font-display text-base font-semibold text-ink-100 print:text-black ${i > 0 ? "mt-4" : ""}`}
                        >
                            {group.title}
                        </h3>
                        <ul
                            class={`mt-1 list-disc space-y-1 pl-5 ${bodyListClass}`}
                        >
                            {group.items.map((item) => (
                                <li>{item}</li>
                            ))}
                        </ul>
                    </>
                ))}
            </div>
        </section>

        <section id="scholarship" class="mt-8 print:mt-4">
            <div class={sectionHeadingClass}>
                <span class={iconBadgeClass}>
                    <Icon name="lucide:lightbulb" class="h-4 w-4" />
                </span>
                <h2 class={headingTextClass}>
                    Scholarship &amp; Professional Activity
                </h2>
            </div>

            <div id="software" class="mt-5 print:mt-3">
                <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-accent-400 print:text-black">Software Development</h3>
            <div class={`mt-3 ${cardClass}`}>
                <ul class={`list-disc space-y-2 pl-5 ${bodyListClass}`}>
                    {software.map((project) => (
                        <li>
                            <span class="font-medium text-ink-200 print:text-black">
                                {project.name}
                            </span>
                            : {project.description}
                            {project.role && <span> — {project.role}</span>}
                            {project.links && project.links.length > 0 && (
                                <span>
                                    {" "}
                                    (
                                    {project.links.map((link, i) => (
                                        <>
                                            {i > 0 && " | "}
                                            <a
                                                href={link.href}
                                                target="_blank"
                                                rel="noreferrer"
                                                class="text-accent-400 print:text-black print:underline"
                                            >
                                                {link.label}
                                            </a>
                                        </>
                                    ))}
                                    )
                                </span>
                            )}
                        </li>
                    ))}
                </ul>
            </div>
            </div>

            <div id="conferences" class="mt-6 print:mt-4">
                <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-accent-400 print:text-black">Conferences &amp; Presentations</h3>
            <div class="mt-3 space-y-3">
                {conferences.map((conf) => (
                    <div class={cardClass}>
                        <p class="font-medium text-ink-200 print:text-black">
                            “{conf.title}”
                            {conf.note && <span>, {conf.note}</span>}
                        </p>
                        <ul
                            class={`mt-1 list-disc space-y-0.5 pl-5 ${bodyListClass}`}
                        >
                            {conf.presentations.map((p) => (
                                <li>
                                    {p.venue} ({p.date})
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
            </div>
        </section>

        <section id="prior-experience" class="mt-8 print:mt-4">
            <div class={sectionHeadingClass}>
                <span class={iconBadgeClass}>
                    <Icon name="lucide:building-2" class="h-4 w-4" />
                </span>
                <h2 class={headingTextClass}>Prior Professional Experience</h2>
            </div>
            <CvOrgList orgs={priorExperience} />
        </section>

        <section id="honors" class="mt-8 print:mt-4">
            <div class={sectionHeadingClass}>
                <span class={iconBadgeClass}>
                    <Icon name="lucide:award" class="h-4 w-4" />
                </span>
                <h2 class={headingTextClass}>Honors and Awards</h2>
            </div>
            <div class={`mt-3 ${cardClass}`}>
                <ul class={`list-disc space-y-1 pl-5 ${bodyListClass}`}>
                    {honors.map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
            </div>
        </section>
    </article>
</BaseLayout>
