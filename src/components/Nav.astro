---
const links = [
  { href: "/#about", label: "About" },
  { href: "/#skills", label: "Skills" },
  { href: "/#projects", label: "Projects" },
  { href: "/#teaching", label: "Teaching" },
];
---

<header class="sticky top-0 z-50 border-b border-ink-800 bg-ink-950/85 backdrop-blur">
	<div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
		<a href="/" class="font-display text-lg font-semibold tracking-tight text-ink-50">
			Pete Benbow
		</a>

		<nav class="hidden items-center gap-8 md:flex">
			{links.map((link) => (
				<a
					href={link.href}
					class="text-sm font-medium text-ink-200 transition-colors hover:text-accent-400"
				>
					{link.label}
				</a>
			))}
			<a
				href="/cv"
				class="rounded-full bg-accent-500 px-4 py-1.5 text-sm font-semibold text-ink-50 transition-colors hover:bg-accent-600"
			>
				CV
			</a>
		</nav>

		<button
			id="nav-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-nav"
			class="flex items-center justify-center rounded-md p-2 text-ink-200 md:hidden"
		>
			<span class="sr-only">Toggle navigation</span>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</button>
	</div>

	<nav id="mobile-nav" class="hidden flex-col gap-1 border-t border-ink-800 px-6 py-4 md:hidden">
		{links.map((link) => (
			<a
				href={link.href}
				class="rounded-md px-2 py-2 text-sm font-medium text-ink-200 hover:bg-ink-800 hover:text-accent-400"
			>
				{link.label}
			</a>
		))}
		<a
			href="/cv"
			class="mt-2 rounded-full bg-accent-500 px-4 py-2 text-center text-sm font-semibold text-ink-50"
		>
			CV
		</a>
	</nav>
</header>

<script>
	const toggle = document.getElementById("nav-toggle");
	const menu = document.getElementById("mobile-nav");

	toggle?.addEventListener("click", () => {
		const isOpen = menu?.classList.toggle("flex");
		menu?.classList.toggle("hidden");
		toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
	});

	menu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			menu.classList.add("hidden");
			menu.classList.remove("flex");
			toggle?.setAttribute("aria-expanded", "false");
		});
	});
</script>
