---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl">
	{eyebrow && (
		<p class="font-display text-sm font-semibold uppercase tracking-wider text-accent-400">
			{eyebrow}
		</p>
	)}
	<h2 class="mt-2 text-3xl font-bold text-ink-50 sm:text-4xl">{title}</h2>
	{description && <p class="mt-3 text-ink-400">{description}</p>}
</div>
