---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="inline-block rounded-full border border-ink-700 bg-ink-900 px-3.5 py-1.5 text-sm font-medium text-ink-200 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-400/60 hover:bg-ink-800 hover:text-accent-400">
	{label}
</span>
